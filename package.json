{
  "name": "reqflow-desktop",
  "productName": "ReqFlow",
  "version": "2.0.0",
  "description": "ReqFlow · 需求流 — Go/MyGO 个人需求管理与 Prompt 工作台",
  "private": true,
  "author": "ReqFlow Local",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:mygo": "node scripts/build-mygo.mjs",
    "check:mygo": "node scripts/go-check.mjs",
    "check:mygo:ui": "node scripts/mygo-ui-check.mjs",
    "typecheck": "tsc --noEmit",
    "dev:renderer": "vite",
    "dev": "npm run build && node scripts/run-go.mjs",
    "start": "node scripts/run-go.mjs",
    "smoke": "node scripts/go-check.mjs",
    "cli-e2e": "node scripts/go-cli-check.mjs",
    "cli": "node scripts/run-go.mjs --cli",
    "icon": "node scripts/make-icon.mjs",
    "dist": "node scripts/package-mygo.mjs",
    "release:github": "node scripts/release-github.mjs",
    "package-check": "node scripts/package-check.mjs",
    "installer-check": "node scripts/package-go-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.27.0",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
